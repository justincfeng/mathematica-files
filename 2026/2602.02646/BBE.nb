Cell[BoxData[{
 RowBox[{"plpsisol", "=", 
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"psizsol", "[", "zz", "]"}], ",", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{
           RowBox[{"psizsol", "[", "zz", "]"}], "^", "2"}], "/", 
          RowBox[{"M", "^", "4"}]}]}], "/.", 
        RowBox[{"{", 
         RowBox[{"M", "->", "1"}], "}"}]}], ")"}]}], "}"}], ",", 
