Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"RED", " ", "IS", " ", "THE", " ", "ANSATZ"}], ",", " ", 
    RowBox[{"BLUE", " ", "IS", " ", "THE", " ", "RECONSTRUCTION"}]}], " ", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Show", "[", 
    RowBox[{"pGSn", ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
