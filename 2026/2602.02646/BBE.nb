Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NIntegrateODEnum", "[", 
    RowBox[{"f_", ",", "x0_", ",", "xf_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"IDef", ",", "x"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"IDef", "[", "x", "]"}], "/.", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              SuperscriptBox["IDef", "\[Prime]",
               MultilineFunction->None], "[", "x", "]"}], "==", 
             RowBox[{"f", "[", "x", "]"}]}], ",", 
            RowBox[{
             RowBox[{"IDef", "[", "x0", "]"}], "==", "0"}]}], "}"}], ",", 
          RowBox[{"IDef", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x0", ",", "xf"}], "}"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"x", "->", "xf"}], "}"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
