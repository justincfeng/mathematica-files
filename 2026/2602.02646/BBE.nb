Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pHEapx", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"2", " ", "k", " ", 
          RowBox[{"(", 
           RowBox[{
            FractionBox[
             RowBox[{"k", " ", "z"}], 
             RowBox[{"1", "+", 
              RowBox[{
               SuperscriptBox["k", "2"], " ", 
               SuperscriptBox["z", "2"]}]}]], "+", 
            RowBox[{"ArcTan", "[", 
             RowBox[{"k", " ", "z"}], "]"}]}], ")"}]}], "\[Pi]"], "/.", 
        RowBox[{"{", 
         RowBox[{"k", "->", "0.27"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Red"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "0.5"}], ",", "1.5"}], "}"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"plhHEsols", ",", "pHEapx"}], "]"}]}]}]], "Input",
