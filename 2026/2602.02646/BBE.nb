          RowBox[{"g1", " ", "\[Psi]s"}]}], "/.", "repsparsmirlin"}], ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Psi]s", ",", "0.5", ",", "1.2"}], "}"}], ",", 
