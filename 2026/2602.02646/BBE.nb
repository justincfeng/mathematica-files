            RowBox[{"zz", ",", "0", ",", "zmax"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{"zz", "->", "zF"}], "}"}]}]}], "]"}]}], ";"}], 
