Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zcA0", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"g00AF", "[", 
           RowBox[{"x", ",", "1.0"}], "]"}], "\[Equal]", "0"}], ",", "x"}], 
        "]"}], "[", 
       RowBox[{"[", "4", "]"}], "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TimeAF", "[", 
    RowBox[{"xz_", ",", "xM_"}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
