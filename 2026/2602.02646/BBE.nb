 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GHreco", "[", 
     RowBox[{"zF_", ",", "zmax_", ",", "\[Psi]_", ",", "aE_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"GH", ",", "zz", ",", "Fret"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"GH", "[", "zz", "]"}], "/.", 
        RowBox[{
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               SuperscriptBox["GH", "\[Prime]",
                MultilineFunction->None], "[", "zz", "]"}], "==", 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"\[Psi]", "[", "zz", "]"}], 
                SuperscriptBox[
                 RowBox[{"aE", "[", "zz", "]"}], "3"]], ")"}]}], ",", 
