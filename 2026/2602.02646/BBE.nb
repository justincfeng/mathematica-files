Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HErcF", "[", "xz_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", "xz"}], 
      RowBox[{"\[Pi]", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         SuperscriptBox["xz", "2"]}], ")"}]}]], "+", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"ArcTan", "[", "xz", "]"}]}], "\[Pi]"]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hErcF", "[", "xz_", "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{"2", "xz", " ", 
     RowBox[{
      RowBox[{"ArcTan", "[", "xz", "]"}], "/", "\[Pi]"}]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aErcF", "[", "xz_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
